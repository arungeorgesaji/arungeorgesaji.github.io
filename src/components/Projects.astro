---
import ProjectItem from './ProjectItem.astro';

import "../styles/Projects.css";
---

<section id="projects">
  <div class="projects-container">
    <h1 class="projects-title">My Projects</h1>
    <div class="project-list">
      <ProjectItem 
        title="Ship" 
        description="Ship is a powerful tool designed to provide easy to use isolated environments in the form of containers and vms." 
        link="https://github.com/arungeorgesaji/ship"
      />
      <ProjectItem 
        title="NeoBrowse" 
        description="A powerful terminal-based browser with a TUI interface, built with Node.js and Blessed."
        link="https://github.com/arungeorgesaji/NeoBrowse"
      />
      <ProjectItem 
        title="Navan" 
        description="Navan is an autonomous robotic boat built to address the growing problem of plastic pollution in waterbodies. Using computer vision and intelligent navigation, Navan can detect, locate, and navigate towards plastic waste for collection, helping keep our rivers, lakes, and coastal areas clean."
        link="https://github.com/theerathile-tech"
      />
      <ProjectItem 
        title="Nanban" 
        description="Nanban is as an assistive device for the visually impaired, combining object detection, distance measurement, and voice assistant capabilities"
        link="https://github.com/Nanban-Vision"
      />
    </div>
  </div>
</section>
